[Container]
NoNewPrivileges=true
ContainerName=immich-db
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
Pod=immich.pod

Volume=immich-postgres.volume:/var/lib/postgresql/data
DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID

Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=immich
Environment=POSTGRES_INITDB_ARGS=--data-checksums
EnvironmentFile=%h/Homelab/secrets/immich

HealthCmd=pg_isready -d immich -U postgres
HealthInterval=10s
HealthRetries=5
Memory=512M

[Install]
WantedBy=default.target
