[Container]
NoNewPrivileges=true
ContainerName=linkwarden-meili
Image=docker.io/getmeili/meilisearch:v1.12.8
Pod=linkwarden.pod

Volume=linkwarden-meili-data.volume:/meili_data
DropCapability=all

EnvironmentFile=%h/Homelab/secrets/linkwarden

HealthCmd=curl -X GET http://127.0.0.1:7700/health
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s
Memory=1G

[Install]
WantedBy=default.target
