[Container]
NoNewPrivileges=true
ContainerName=slskd
Image=docker.io/slskd/slskd:latest
Pod=slskd.pod

User=1000:1000
DropCapability=all

Volume=%h/Homelab/data/slskd/data/slskd-config:/app:z
Volume=/mnt/data/media/media/music:/music:ro,z
Volume=/mnt/data/media/media/books:/books:ro,z
Volume=/mnt/data/media/downloads/soulseek:/data/downloads/soulseek:z
Volume=%h/Homelab/downloads/soulseek:/incomplete:z

Environment=TZ=Europe/Madrid
Environment=SLSKD_SHARED_DIR=/music
Environment=SLSKD_DOWNLOADS_DIR=/data/downloads/soulseek

AutoUpdate=registry

HealthCmd=wget -qO- http://localhost:5030/ > /dev/null
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s

[Service]
MemoryMax=512M

[Install]
WantedBy=default.target
