[Container]
NoNewPrivileges=true
ContainerName=mularr
Image=ghcr.io/joecarl/mularr:latest
Pod=mularr.pod

User=1000:1000
DropCapability=all

Volume=%h/Homelab/data/mularr/data/mularr-config:/app/data:z
Volume=/mnt/data/downloads/amule:/data/downloads/amule:z
Volume=/mnt/data/downloads/temp/amule:/incomplete:z

Environment=TZ=Europe/Madrid
Environment=AMULE_INCOMING_DIR=/data/downloads/amule
Environment=AMULE_TEMP_DIR=/incomplete
EnvironmentFile=%h/Homelab/secrets/mularr

AutoUpdate=registry

HealthCmd=node -e "require('http').get('http://localhost:8940/',r=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s

[Service]
MemoryMax=512M

[Install]
WantedBy=default.target
