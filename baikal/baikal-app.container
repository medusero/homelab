[Container]
NoNewPrivileges=true
ContainerName=baikal-app
Image=docker.io/ckulka/baikal:latest
Pod=baikal.pod

Volume=%h/Homelab/data/baikal/data/baikal-config:/var/www/baikal/config:z
Volume=%h/Homelab/data/baikal/data/baikal-data:/var/www/baikal/Specific:z

EnvironmentFile=%h/.config/containers/systemd/secrets/baikal

DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE

AutoUpdate=registry

HealthCmd=curl -sf http://localhost:80/
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s

[Service]
MemoryMax=512M

[Install]
WantedBy=default.target
