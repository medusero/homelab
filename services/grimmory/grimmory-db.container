[Container]
NoNewPrivileges=true
ContainerName=grimmory-db
Image=lscr.io/linuxserver/mariadb:11.4.12
Pod=grimmory.pod

Volume=grimmory-mariadb.volume:/config

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Madrid
EnvironmentFile=%h/Homelab/secrets/grimmory-db

DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID

HealthCmd=mariadb-admin ping -h localhost
HealthInterval=10s
HealthRetries=5
Memory=512M

[Unit]
After=grimmory.pod

[Install]
WantedBy=default.target
