[Container]
NoNewPrivileges=true
ContainerName=lidarr-app
Image=lscr.io/linuxserver/lidarr:nightly
Pod=lidarr.pod

Volume=%h/Homelab/data/lidarr/data/lidarr-config:/config:z
Volume=/mnt/data/media:/data:z

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Madrid

DropCapability=all
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID

AutoUpdate=registry

HealthCmd=curl -sf http://localhost:8686/ping || exit 1
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=30s

[Service]
MemoryMax=512M

[Install]
WantedBy=default.target
