[Container]
NoNewPrivileges=true
ContainerName=openwebui-app
Image=ghcr.io/open-webui/open-webui:main
Pod=openwebui.pod

Volume=%h/Homelab/data/openwebui/data:/app/backend/data:z
Volume=/etc/localtime:/etc/localtime:ro

Environment=TZ=Europe/Madrid
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=WEBUI_AUTH=true
Environment=HOST=127.0.0.1
Environment=PORT=8080
EnvironmentFile=%h/Homelab/secrets/openwebui

DropCapability=all

AutoUpdate=registry

HealthCmd=curl -sf http://127.0.0.1:8080/ || exit 1
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=45s
MemoryMax=4G

[Unit]
After=network-online.target

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=180

[Install]
WantedBy=default.target
