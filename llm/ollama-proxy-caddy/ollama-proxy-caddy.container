[Container]
NoNewPrivileges=true
ContainerName=ollama-proxy-caddy
Image=docker.io/library/caddy:alpine
Pod=ollama-proxy.pod

DropCapability=all
AddCapability=NET_BIND_SERVICE

Volume=%h/Homelab/data/ollama-proxy/Caddyfile:/etc/caddy/Caddyfile:ro,z

AutoUpdate=registry

HealthCmd=wget -q -O- http://127.0.0.1:11435/ >/dev/null 2>&1 || exit 1
HealthInterval=1m
HealthRetries=3
HealthStartPeriod=20s

[Unit]
After=network-online.target

[Service]
MemoryMax=128M

[Install]
WantedBy=default.target
